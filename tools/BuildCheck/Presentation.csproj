<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>StarPawn.Presentation</AssemblyName>
    <RootNamespace>StarPawn.Presentation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0169;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 表现层源码（Unity 侧由 asmdef 编译；这里用 UnityEngine 桩做离线编译验证） -->
    <Compile Include="$(MSBuildProjectDirectory)/../../game/Packages/com.starpawn.presentation/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="UnityEngine.CoreModule/UnityEngine.CoreModule.csproj" />
    <ProjectReference Include="Application.csproj" />
    <ProjectReference Include="Navigation_Contracts.csproj" />
    <ProjectReference Include="Fleet_Contracts.csproj" />
    <ProjectReference Include="Economy_Contracts.csproj" />
    <ProjectReference Include="Progression_Contracts.csproj" />
    <ProjectReference Include="Relations_Contracts.csproj" />
    <ProjectReference Include="Narrative_Contracts.csproj" />
    <ProjectReference Include="Combat_Contracts.csproj" />
    <ProjectReference Include="Officer_Contracts.csproj" />
    <ProjectReference Include="Foundation.csproj" />
  </ItemGroup>
</Project>
